# Airflow metadata database credentials used by the images themselves
POSTGRES_USER=airflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=airflow
POSTGRES_HOST=airflow-postgres
POSTGRES_PORT=5434

# Container user id, keeps mounted files owned by you instead of root
AIRFLOW_UID=50000

AIRFLOW__CORE__EXECUTOR=LocalExecutor

# Turn off the "test connection" banner for the UI connections page
AIRFLOW__CORE__TEST_CONNECTION=Enabled

# Encrypts stored connection passwords. Generate a new one for every
# installation and keep it secret:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=replace-with-a-generated-fernet-key

# Connection the DAG uses to write into the source database.
# Format: postgresql://user:password@host:port/database
AIRFLOW_CONN_POSTGRES_SOURCE=postgresql://postgres:change-me@postgres_source:5432/sales_db

DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=postgres_source
DB_PORT=5432
DB_NAME=sales_db

MINIO_ENDPOINT=http://minio-lakehouse:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me
BRONZE_BUCKET=bronze