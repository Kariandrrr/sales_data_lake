# PostgreSQL source, reachable from the Airflow containers by service name
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=postgres_source
DB_PORT=5432
DB_NAME=sales_db

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sales_db
POSTGRES_PORT=5433

# MinIO. Use the compose service or container name
MINIO_ENDPOINT=minio-lakehouse:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me

# Bucket that holds the bronze layer
BRONZE_BUCKET=bronze

#ClickHouse
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=change-me
CLICKHOUSE_DB=default